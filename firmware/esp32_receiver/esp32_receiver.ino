/*
 * Arduino IDE entry point for the PhyAuth-RF receiver node.
 *
 * All code lives in src/ (main.cpp, phyauth_dsp.c, phyauth_model.h); the
 * Arduino IDE compiles that folder automatically. PlatformIO users: run
 * `pio run -t upload` in this directory instead.
 *
 * Board: "ESP32 Dev Module" (classic ESP32) or "ESP32S3 Dev Module", CPU 240 MHz.
 * Serial monitor: 921600 baud. PlatformIO: `pio run -e esp32dev|esp32s3 -t upload`.
 */
